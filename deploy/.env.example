# Copiar a .env en el servidor y rellenar. NO se versiona.

# ── Ambiente ─────────────────────────────────────────────────────────
# Decide qué application-<valor>.properties se carga sobre el base.
# Valores esperados: dev | prod. El servidor actual es dev.
# También decide el esquema de la base: dev → stackline_dev y agents_dev,
# prod → stackline_prod y agents_prod (se crean vacíos a mano).
APP_ENV=dev

# ── Base de datos ────────────────────────────────────────────────────
# Host de la base. Vacío o "db" usa el contenedor (perfil local-db); un
# endpoint de RDS la saca fuera y el contenedor deja de levantarse.
DB_HOST=db
DB_PORT=5432
DB_NAME=erp_maya
DB_USER=erp_maya
# Generar con:  openssl rand -base64 24
DB_PASSWORD=

# ── Firma de tokens ──────────────────────────────────────────────────
# HS256 exige al menos 256 bits. Generar con:  openssl rand -base64 48
# Cambiarlo invalida todas las sesiones abiertas.
JWT_SECRET=

# ── Primer acceso ────────────────────────────────────────────────────
# Se crea al arrancar por primera vez y no vuelve a tocarse. El código de
# empresa es lo que se escribe en la pantalla de login junto al correo.
SEED_COMPANY_CODE=STACKLINE
SEED_COMPANY_NAME=Stackline
SEED_ADMIN_EMAIL=
# Generar con:  openssl rand -base64 18
SEED_ADMIN_PASSWORD=

# ── Dirección pública ────────────────────────────────────────────────
# Sin dominio propio hay dos opciones:
#
#   SITE_ADDRESS=:80                    HTTP plano. La contraseña y el token
#                                       viajan en claro. Solo para probar.
#
#   SITE_ADDRESS=203.0.113.10.sslip.io  HTTPS real y gratis. sslip.io resuelve
#                                       a la IP que lleva embebida en el
#                                       nombre, así que Let's Encrypt puede
#                                       validarlo. Sustituir por TU IP.
SITE_ADDRESS=:80
# Requerido solo si usas sslip.io: Let's Encrypt avisa aquí si un cert falla.


# ── Rutas ────────────────────────────────────────────────────────────
# Carpeta del repositorio del front, relativa a deploy/. En el servidor,
# clonado con su nombre real, el valor por defecto ya sirve.
UI_CONTEXT=../../stack-line-ui

# ── Consola de plataforma (stack-line-gestion-ui) ────────────────────
# Primer dueño: se crea al arrancar si la tabla de operadores está vacía.
# Contraseña de 12 caracteres o más. Después de entrar, se puede quitar.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=
# Pantalla de activación de la app, p. ej. https://1-2-3-4.sslip.io/activar
PLATFORM_ACTIVATION_URL=

# ── JVM ──────────────────────────────────────────────────────────────
# En un servidor de 2 GB conviene bajarlo a 50.
JAVA_OPTS=-XX:MaxRAMPercentage=70

# ── Asistente comercial (agents-services) ────────────────────────────
# Llave compartida ERP ↔ agente. Generar con:  openssl rand -base64 32
AGENT_KEY_ERP=
# Memoria del contenedor del agente. En una máquina de 2 GB, dejar 768m y
# bajar JAVA_OPTS del backend a -XX:MaxRAMPercentage=50.
AGENTS_MEM_LIMIT=768m
# Llave del proveedor del modelo (la que nombre ai_provider.credential_ref).
ANTHROPIC_API_KEY=
# WhatsApp Cloud API (Meta). El webhook queda en
#   https://<SITE_ADDRESS>/webhooks/whatsapp
# y Meta exige HTTPS con certificado válido.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_STICKERS_ENABLED=true
